<?php
$config = @parse_ini_file('/boot/config/plugins/wise.route.manager/wise.route.manager.cfg') ?: [];
$candidateUrl = trim($config['APP_URL'] ?? '');
$defaultAppdata = trim($config['DEFAULT_APPDATA'] ?? '');
$appdataMode = trim($config['APPDATA_MOUNT_MODE'] ?? '');
$appdataDriveType = trim($config['APPDATA_DRIVE_TYPE'] ?? '');
$installMessage = '';
$installError = '';
$storageScan = [];
$scanScript = '/usr/local/emhttp/plugins/wise.route.manager/wrm-storage-scan.sh';
if (is_executable($scanScript)) {
    foreach (preg_split('/\r?\n/', trim((string) @shell_exec($scanScript . ' 2>/dev/null'))) as $line) {
        $fields = explode("\t", $line);
        if (count($fields) >= 6 && $fields[0] !== '') {
            [$path, $kind, $drive, $filesystem, $mode, $meta, $foundPathList] = array_pad($fields, 7, '');
            [$references, $configured] = array_pad(explode(':', $meta, 2), 2, 'no');
            $foundPaths = array_values(array_filter(array_unique(explode('|', $foundPathList))));
            $storageScan[] = compact('path', 'kind', 'drive', 'filesystem', 'mode', 'references', 'configured', 'foundPaths');
        }
    }
}
$defaultStorage = null;
foreach ($storageScan as $storage) {
    if (($storage['configured'] ?? '') === 'yes') {
        $defaultStorage = $storage;
        break;
    }
}
if ($defaultStorage === null && !empty($storageScan)) {
    $defaultStorage = $storageScan[0];
}
$selectedRoot = $defaultStorage['path'] ?? $defaultAppdata;
$selectedRoot = rtrim($selectedRoot, '/');
$suggestedHostPath = $selectedRoot !== '' ? $selectedRoot . '/wise-route-manager-lite' : '';
$suggestedMode = ($defaultStorage['mode'] ?? '') === 'Read/Write - Slave' || $appdataMode === 'rw,slave' ? 'rw,slave' : 'rw';
$suggestedIp = trim((string) @shell_exec('/usr/local/emhttp/plugins/wise.route.manager/wrm-ip-suggest.sh br0 2>/dev/null'));
if ($suggestedIp === '') {
    $suggestedIp = '192.168.1.40';
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['wrm_action'] ?? '') === 'create_container') {
    $hostPath = trim((string) ($_POST['host_path'] ?? ''));
    $ipAddress = trim((string) ($_POST['ip_address'] ?? ''));
    $mountMode = trim((string) ($_POST['mount_mode'] ?? 'rw'));
    if (!preg_match('#^/mnt/[^[:cntrl:]]+$#', $hostPath)) {
        $installError = 'Choose an appdata path under /mnt before creating the container.';
    } elseif (!filter_var($ipAddress, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
        $installError = 'Enter a valid IPv4 address for the container.';
    } elseif (!in_array($mountMode, ['rw', 'rw,slave'], true)) {
        $installError = 'Choose a valid appdata access mode.';
    } else {
        $command = '/usr/local/emhttp/plugins/wise.route.manager/wrm-container-install.sh '
            . escapeshellarg($hostPath) . ' '
            . escapeshellarg($ipAddress) . ' '
            . escapeshellarg($mountMode) . ' 2>&1';
        $output = [];
        $exitCode = 1;
        @exec($command, $output, $exitCode);
        if ($exitCode === 0) {
            $installMessage = implode("\n", $output);
            $candidateUrl = 'http://' . $ipAddress . ':9080';
            $configuredUrl = $candidateUrl;
        } else {
            $installError = implode("\n", $output) ?: 'Container creation failed. Check Docker, br0, the selected IP, and the appdata path.';
        }
    }
}

$parts = @parse_url($candidateUrl);
$scheme = is_array($parts) ? ($parts['scheme'] ?? '') : '';
$configuredUrl = is_array($parts) && in_array($scheme, ['http', 'https'], true) && !empty($parts['host']) ? $candidateUrl : '';
$url = htmlspecialchars($configuredUrl, ENT_QUOTES, 'UTF-8');
?>
