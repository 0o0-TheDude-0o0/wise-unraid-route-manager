          <tr>
            <td><code><?= htmlspecialchars($storage['path'], ENT_QUOTES, 'UTF-8') ?></code><?php if ($storage['configured'] === 'yes'): ?> <span class="wrm-default">Default</span><?php endif; ?></td>
            <td><?= htmlspecialchars($storage['kind'], ENT_QUOTES, 'UTF-8') ?><br><span class="wrm-help"><?= htmlspecialchars($storage['filesystem'] ?: 'filesystem unknown', ENT_QUOTES, 'UTF-8') ?></span></td>
            <td><?= htmlspecialchars($storage['drive'], ENT_QUOTES, 'UTF-8') ?></td>
            <td><?= htmlspecialchars($storage['mode'], ENT_QUOTES, 'UTF-8') ?></td>
